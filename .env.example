# Copy this file to `.env.docker`

# GitHub Models - required for NL queries
GITHUB_MODELS_TOKEN=
GITHUB_MODEL=gpt-4o-mini
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com

# Mongo/App
# For Docker Compose, the Mongo hostname is the service name: `mongo`
MONGO_URI=mongodb://mongo:27017/
MONGO_DB=telemetry_db
MONGO_COLLECTION=telemetry_data
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

